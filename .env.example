# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for sending emails via Resend.
# Get one at https://resend.com
RESEND_API_KEY=""

# TWILIO_ACCOUNT_SID: Required for sending SMS via Twilio.
# Get one at https://www.twilio.com
TWILIO_ACCOUNT_SID=""

# TWILIO_AUTH_TOKEN: Required for sending SMS via Twilio.
TWILIO_AUTH_TOKEN=""

# TWILIO_PHONE_NUMBER: Your Twilio phone number.
TWILIO_PHONE_NUMBER=""

# SUPABASE_CONFIGURATION
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# RAZORPAY ENVIRONMENT VARIABLES
# Get these from your Razorpay Dashboard (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

